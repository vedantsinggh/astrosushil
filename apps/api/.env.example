# Environment Configuration Example for Astro Sushil API

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/astro_sushil?schema=public"

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
