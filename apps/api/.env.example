# Environment Configuration Example for Astro Sushil API

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=astro_sushil_dev
POSTGRES_PORT=5432

# Database Connection URL (Local PostgreSQL Docker Container)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/astro_sushil_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/astro_sushil_test?schema=public"
# The API always opens its PostgreSQL sessions with TimeZone=UTC (it adds
# options=-c TimeZone=UTC to DATABASE_URL itself), so report claim leases and
# retry schedules are correct whatever the server's TimeZone is. Set false only
# behind a pooler that rejects the "options" startup parameter; the server's
# TimeZone must then be UTC.
# DATABASE_FORCE_UTC_SESSION=true

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SAME_SITE=lax
# Defaults to true in production. Required for AUTH_COOKIE_SAME_SITE=none.
AUTH_COOKIE_SECURE=false
# Leave unset for host-only API auth cookies; set only when sharing cookies across subdomains.
# AUTH_COOKIE_DOMAIN=.astrosushil.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Development / Staging Master OTP Configuration
# MUST BE DISABLED IN PRODUCTION (ALLOW_DEV_MASTER_OTP=false)
DEV_MASTER_OTP=444444
ALLOW_DEV_MASTER_OTP=true

# Email Service Configuration (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=smtp_user
EMAIL_PASSWORD=smtp_password
EMAIL_FROM="Astro Sushil <noreply@astrosushil.com>"

# Google Sign-In
# Comma-separated OAuth client IDs whose Google ID tokens are accepted (token `aud`).
# List the Web client ID (passed to the app as GOOGLE_SERVER_CLIENT_ID) and the iOS client ID.
# Required in production: Google sign-in is refused when this is empty.
GOOGLE_OAUTH_CLIENT_IDS=

# OpenRouter & Jyoti AI Assistant Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m3:free
JYOTI_RATE_LIMIT_PER_MINUTE=20
JYOTI_DAILY_LIMIT=200

# LaTeX.to CLI Compiler Configuration
LATEX_COMPILER=latexto

# Automated PDF Quality Assurance Gate Configuration (true by default in production; set to false in dev to bypass QA blocking)
REPORT_PDF_QA_ENABLED=true

# Report jobs and restarts. In development (instant execution on), the API runs
# reports itself and, on every start, resumes reports interrupted by a restart.
# REPORT_INSTANT_EXECUTION=false leaves reports to the worker (npm run dev:worker).
# `npm run dev` (tsx watch) restarts on every saved file; each restart releases
# the running report and the new process starts it again (cached topics are
# reused). To keep long reports running while you edit code, set
# REPORT_INSTANT_EXECUTION=false and run the worker WITHOUT watch in a second
# terminal: (cd apps/api && npx tsx src/worker.ts)
# REPORT_SHUTDOWN_GRACE_MS=2000      # on SIGTERM/SIGINT wait this long, then release in-flight claims
# REPORT_DISPATCH_INTERVAL_MS=15000  # API (instant mode): how often to pick up queued / retry-due reports
# STALE_JOB_RECOVERY_INTERVAL_MS=60000
# WORKER_HEARTBEAT_INTERVAL_MS=20000 # renews the 60 s claim lease
# REPORT_WORKER_INSTANCE_ID=         # only if you run two processes of the same role on one host
