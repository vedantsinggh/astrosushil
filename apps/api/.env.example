# Environment Configuration Example for Astro Sushil API

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=astro_sushil_dev
POSTGRES_PORT=5432

# Database Connection URL (Local PostgreSQL Docker Container)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/astro_sushil_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/astro_sushil_test?schema=public"

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
