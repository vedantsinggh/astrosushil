// Prisma Schema for Astro Sushil Platform Backend Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReportType {
  KUNDLI
  PLANETARY_SUMMARY
  MARRIAGE_COMPATIBILITY
  CAREER_PROSITY
  CHILDBIRTH_FAMILY
  GUPTA_NADI_DOSSIER
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  fullName        String?
  phoneNumber     String?
  emailVerifiedAt DateTime?
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  birthProfiles    BirthProfile[]
  refreshTokens   RefreshToken[]
  otpVerifications OtpVerification[]
  orders          Order[]
  reports         Report[]
  deviceTokens    DeviceToken[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpVerification {
  id        String              @id @default(uuid())
  userId    String
  codeHash  String
  purpose   VerificationPurpose
  expiresAt DateTime
  attempts  Int                 @default(0)
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
  @@map("otp_verifications")
}

model BirthProfile {
  id          String   @id @default(uuid())
  userId      String
  name        String
  dateOfBirth String   // Canonical format: YYYY-MM-DD
  timeOfBirth String   // Canonical 24h format: HH:mm:ss
  latitude    Float    // Decimal degrees [-90, 90]
  longitude   Float    // Decimal degrees [-180, 180]
  timezone    String   // IANA Timezone ID (e.g. "Asia/Kolkata")
  placeName   String?  // Optional display place name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@map("birth_profiles")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  razorpayOrderId   String      @unique
  razorpayPaymentId String?     @unique
  amount            Int         // Amount in paise
  currency          String      @default("INR")
  status            OrderStatus @default(PENDING)
  reportType        ReportType
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@map("orders")
}

model Report {
  id             String       @id @default(uuid())
  userId         String
  birthProfileId String
  orderId        String?
  reportType     ReportType
  status         ReportStatus @default(PENDING)
  s3Url          String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([birthProfileId])
  @@map("reports")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  fcmToken   String   @unique
  deviceType String   // "ANDROID" | "IOS" | "WEB"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
