generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String
  role                   Role                    @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  fullName               String?
  phoneNumber            String?
  emailVerifiedAt        DateTime?
  birthProfiles          BirthProfile[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  orders                 Order[]
  otpVerifications       OtpVerification[]
  refreshTokens          RefreshToken[]
  reports                Report[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpVerification {
  id        String              @id @default(uuid())
  userId    String
  codeHash  String
  purpose   VerificationPurpose
  expiresAt DateTime
  attempts  Int                 @default(0)
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
  @@map("otp_verifications")
}

model BirthProfile {
  id          String   @id @default(uuid())
  userId      String
  name        String
  dateOfBirth String
  timeOfBirth String
  latitude    Float
  longitude   Float
  timezone    String
  placeName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([userId])
  @@map("birth_profiles")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  razorpayOrderId   String      @unique
  razorpayPaymentId String?     @unique
  amount            Int
  currency          String      @default("INR")
  status            OrderStatus @default(PENDING)
  reportType        ReportType
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports           Report[]

  @@index([userId])
  @@map("orders")
}

model Report {
  id                 String       @id @default(uuid())
  userId             String
  birthProfileId     String
  orderId            String?
  reportType         ReportType
  status             ReportStatus @default(QUEUED)
  s3Url              String?
  errorMessage       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  stage              String?      @default("QUEUED")
  progress           Int          @default(0)
  reportVersion      String       @default("1.0.0")
  calculationVersion String       @default("1.0.0")
  storageKey         String?
  fileName           String?
  fileSize           Int?
  pageCount          Int?
  errorCode          String?
  completedAt        DateTime?
  failedAt           DateTime?
  birthProfile       BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  order              Order?       @relation(fields: [orderId], references: [id])
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([birthProfileId])
  @@map("reports")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  fcmToken   String   @unique
  deviceType String
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  pushEnabled        Boolean  @default(true)
  emailEnabled       Boolean  @default(true)
  astrologyReminders Boolean  @default(true)
  reportAlerts       Boolean  @default(true)
  promotions         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String
  resource   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReportType {
  MARRIAGE_COMPATIBILITY
  CAREER_PROSITY
  CHILDBIRTH_FAMILY
  GUPTA_NADI_DOSSIER
  CAREER
  KUNDLI
  PLANETARY_SUMMARY
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  QUEUED
  CALCULATING
  ANALYZING
  RENDERING
  COMPILING
  UPLOADING
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
