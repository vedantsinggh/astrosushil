{
  "name": "@astro/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --fileParallelism=false --reporter=junit --outputFile=../../test-results/api.xml",
    "test:report": "vitest run --root=../.. --config=vitest.config.ts --fileParallelism=false packages/report-engine/src/__tests__ --reporter=junit --outputFile=test-results/report.xml",
    "test:prediction": "vitest run --root=../.. --config=vitest.config.ts --fileParallelism=false packages/prediction-engine/src/__tests__ packages/prediction-engine/src/interpretation/__tests__ --reporter=junit --outputFile=test-results/prediction.xml",
    "test:watch": "vitest",
    "test:openrouter": "tsx src/scripts/test-openrouter.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@astro/astrology-engine": "*",
    "@astro/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.9",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@prisma/client": "^5.14.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.6.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.2",
    "mongodb": "^7.9.1",
    "prisma": "^5.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
