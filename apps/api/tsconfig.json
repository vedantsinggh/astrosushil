{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@astro/shared": ["../../packages/shared/src", "../../packages/shared/dist"],
      "@astro/astrology-engine": ["../../packages/astrology-engine/src", "../../packages/astrology-engine/dist"],
      "@astro/gupta-nadi-engine": ["../../packages/gupta-nadi-engine/src", "../../packages/gupta-nadi-engine/dist"],
      "@astro/prediction-engine": ["../../packages/prediction-engine/src", "../../packages/prediction-engine/dist"],
      "@astro/report-engine": ["../../packages/report-engine/src", "../../packages/report-engine/dist"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/astrology-engine" },
    { "path": "../../packages/gupta-nadi-engine" },
    { "path": "../../packages/prediction-engine" },
    { "path": "../../packages/report-engine" }
  ]
}
