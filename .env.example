# ==============================================================================
# Astro Sushil Production & Staging Environment Variable Configuration Template
# DO NOT ADD REAL PRODUCTION SECRETS OR KEYS TO THIS TEMPLATE FILE.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_BASE_URL=https://api.astrosushil.com
ADMIN_BASE_URL=https://admin.astrosushil.com

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://user:password@production-db.internal:5432/astro_sushil_prod?sslmode=require&schema=public"

# Redis Cache & BullMQ Queue Configuration
REDIS_HOST=production-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_TLS_ENABLED=true
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# JWT Authentication Secrets (Must be unique, cryptographically random, >= 32 chars)
JWT_SECRET=replace_with_secure_random_string_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LaTeX Compilation Strategy Configuration ('local' or 'latexto')
LATEX_COMPILER=local

# Automated PDF Quality Assurance Gate Configuration (true by default in production; set to false in dev to bypass QA blocking)
REPORT_PDF_QA_ENABLED=true

# OpenRouter LLM Provider Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_live_razorpay_webhook_secret

# Cloudflare R2 / AWS S3 Object Storage Configuration (Private PDF Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=astrosushil-reports-prod
R2_REGION=auto

# Legacy S3 Fallback Configuration (Optional)
S3_REGION=ap-south-1
S3_BUCKET_NAME=astrosushil-reports-prod
S3_ACCESS_KEY_ID=your_aws_s3_access_key
S3_SECRET_ACCESS_KEY=your_aws_s3_secret_access_key

# Transactional Email Configuration (SMTP / Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_email_service_api_key
EMAIL_FROM="Astro Sushil <noreply@astrosushil.com>"

# Firebase Cloud Messaging (FCM) Configuration (Push Notifications)
FIREBASE_PROJECT_ID=astrosushil-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@astrosushil-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourFirebasePrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Security & CORS Configuration
CORS_ORIGIN="https://admin.astrosushil.com,https://astrosushil.com"
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
