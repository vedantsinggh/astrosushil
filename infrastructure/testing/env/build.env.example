# Astro Sushil TESTING - compose interpolation variables (build args, sizing knobs).
# Installed as $TESTING_ROOT/env/build.env and passed with `--env-file` by testing_compose.
# These values are NOT injected into containers; they fill ${...} in docker-compose.testing.yml.
# No secrets belong in this file.

# --- Images -----------------------------------------------------------------------
# Tag for astro-testing-api / astro-testing-admin / astro-testing-website.
TESTING_IMAGE_TAG=local

# --- Frontend API base (baked into images at build time) ----------------------------
# Relative = same origin as the page; the testing proxy forwards /api/ to the API.
# Never set these to a production host (install/verify refuse astrosushil.com hosts).
TESTING_WEBSITE_API_URL=/api/v1
TESTING_ADMIN_API_URL=/

# --- Network ------------------------------------------------------------------------
# Fixed subnet of the testing_edge network. The API trusts X-Forwarded-* only from
# this CIDR (TRUST_PROXY). Change it only if it collides with an existing host network
# (check `ip route` / `docker network inspect`).
TESTING_EDGE_SUBNET=172.30.118.0/24

# --- Optional Cloudflare quick tunnel image (profile "tunnel") ----------------------
TESTING_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2024.12.2

# --- Resource limits (container memory hard limits / CPU quotas) ---------------------
# Memory values use Docker units (m, g). The Node heap (*_NODE_HEAP_MB) must stay well
# below the container limit: native memory, buffers and child processes need the rest.
# See infrastructure/testing/docs/compose-architecture.md for the sizing table.
# PostgreSQL image of testing-postgres. Must match the MAJOR version of the source
# database you back up (pg_restore cannot read a newer major's archive).
# Production (infrastructure/deployment/vm) runs PostgreSQL 16. If your local migrated
# database runs on PostgreSQL 18, either back it up into a 16 cluster first or set
# postgres:18-alpine here and pass --target-major 18 to backup-local-db.sh.
# Changing the major after the volume exists needs a reset (new empty volume).
TESTING_POSTGRES_IMAGE=postgres:18-alpine
TESTING_POSTGRES_MEM_LIMIT=512m
TESTING_POSTGRES_CPUS=1.0
TESTING_REDIS_MEM_LIMIT=96m
TESTING_REDIS_CPUS=0.25
# Redis internal cap (must be below TESTING_REDIS_MEM_LIMIT).
TESTING_REDIS_MAXMEMORY=64mb
TESTING_MIGRATE_MEM_LIMIT=512m
TESTING_MIGRATE_CPUS=1.0
TESTING_API_MEM_LIMIT=512m
TESTING_API_CPUS=1.0
TESTING_API_NODE_HEAP_MB=384
# The worker limit includes the XeLaTeX / pdftoppm / ghostscript peak during PDF builds.
TESTING_WORKER_MEM_LIMIT=1536m
TESTING_WORKER_CPUS=1.5
TESTING_WORKER_NODE_HEAP_MB=768
TESTING_ADMIN_MEM_LIMIT=384m
TESTING_ADMIN_CPUS=0.5
TESTING_ADMIN_NODE_HEAP_MB=256
TESTING_WEBSITE_MEM_LIMIT=64m
TESTING_WEBSITE_CPUS=0.25
TESTING_PROXY_MEM_LIMIT=64m
TESTING_PROXY_CPUS=0.5
TESTING_TUNNEL_MEM_LIMIT=128m
TESTING_TUNNEL_CPUS=0.25
