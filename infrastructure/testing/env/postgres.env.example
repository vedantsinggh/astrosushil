# Astro Sushil TESTING - Postgres container environment.
# Installed as $TESTING_ROOT/env/postgres.env (mode 600) by install-testing.sh,
# which replaces __GENERATE__ with a random password. Never reuse a production password.
# The same password goes into DATABASE_URL in $TESTING_ROOT/env/api.env:
#   postgresql://astro_testing:<password>@testing-postgres:5432/astro_sushil_testing?schema=public
#
# POSTGRES_* values are read only when the data volume (testing_pgdata) is first
# initialised. Changing them later does not change the existing database role.

POSTGRES_USER=astro_testing
POSTGRES_DB=astro_sushil_testing
POSTGRES_PASSWORD=__GENERATE__

# Data directory inside the testing_pgdata volume (image default made explicit).
PGDATA=/var/lib/postgresql/data/pgdata
