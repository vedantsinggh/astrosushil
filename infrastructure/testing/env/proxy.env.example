# Astro Sushil TESTING proxy settings.
# Installed as $TESTING_ROOT/env/proxy.env (mode 600). Read by docker compose
# (--env-file) for port publishing and by scripts/render-proxy-access.sh, which
# turns it into $TESTING_ROOT/nginx/access-{website,admin,api}.conf + htpasswd.
# After editing: re-run render-proxy-access.sh, then restart testing-proxy
# (re-create it if you changed a port or TESTING_BIND_ADDRESS).
# No secrets belong in this file. The basic-auth password is generated by
# install-testing.sh and stored only as a hash in $TESTING_ROOT/nginx/htpasswd.
# Full explanation: infrastructure/testing/docs/public-access.md

# ---------------------------------------------------------------- publishing ---
# Host address the website (18080) and admin (18081) ports are published on.
#   0.0.0.0    Mode A: reachable as http://VPS_IP:18080 / :18081 (if the firewall
#              allows it). Login does NOT work over plain http (Secure cookies).
#   127.0.0.1  Once a host proxy (Caddy/Nginx) or a tunnel serves HTTPS hostnames.
#              Closes raw-IP access. Recommended as soon as HTTPS works.
TESTING_BIND_ADDRESS=0.0.0.0
TESTING_WEBSITE_PORT=18080
TESTING_ADMIN_PORT=18081
# The API-only origin is ALWAYS published on 127.0.0.1 only (for the host proxy's
# api-test hostname). It is never exposed on the raw IP.
TESTING_API_PORT=18082

# ---------------------------------------------------------- access control ---
# HTTP basic auth on the website and admin origins (not on the API-only origin,
# which the mobile app and webhook senders use). Keep true unless the whole
# deployment is already restricted by TESTING_ALLOWED_CIDRS.
TESTING_BASIC_AUTH_ENABLED=true
TESTING_BASIC_AUTH_USER=client

# Optional source-IP allowlist, comma-separated CIDRs or single addresses,
# e.g. 203.0.113.10/32,198.51.100.0/24. Empty = no IP restriction.
# Applies to all three origins (/healthz is always allowed). On the API-only
# origin this also blocks the mobile app on other networks and Razorpay /
# WhatsApp webhooks unless their source addresses are listed.
# If a host proxy or tunnel sits in front, TESTING_TRUSTED_PROXY_CIDRS must be
# set too, otherwise every request appears to come from the proxy's address.
TESTING_ALLOWED_CIDRS=

# Addresses whose X-Forwarded-For header is trusted for the real client IP.
# Empty = trust nobody: allow/deny and logs see the TCP peer address.
# When the host Caddy/Nginx connects to 127.0.0.1:18080, Docker's port
# publishing hands the connection to the container from the GATEWAY address of
# the compose network (e.g. 172.18.0.1), not from 127.0.0.1. Find it with:
#   docker network inspect astro_testing_testing_edge \
#     -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# and confirm in the proxy log (realip="..." field) after one request.
# Cloudflare tunnel containers connect from their own testing_edge address, so
# for tunnels use the whole subnet:
#   docker network inspect astro_testing_testing_edge \
#     -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Example: TESTING_TRUSTED_PROXY_CIDRS=172.18.0.0/16
# Never put public addresses or 0.0.0.0/0 here: that lets anyone spoof their IP.
TESTING_TRUSTED_PROXY_CIDRS=

# ------------------------------------------------------------- public URLs ---
# What people type in the browser / what the mobile app uses. Informational for
# verify-testing.sh and the runbook; the API's CORS_ORIGIN, FRONTEND_URL,
# ADMIN_URL and PUBLIC_API_URL in env/api.env must match these.
# Mode A example:  http://VPS_IP:18080  http://VPS_IP:18081  (API: none public)
# Mode B example:  https://test.CLIENT_DOMAIN  https://admin-test.CLIENT_DOMAIN
#                  https://api-test.CLIENT_DOMAIN
TESTING_PUBLIC_WEBSITE_URL=__SET_ME__
TESTING_PUBLIC_ADMIN_URL=__SET_ME__
TESTING_PUBLIC_API_URL=__SET_ME__
