# =============================================================================
# Astro Sushil TESTING deployment - API + worker environment.
#
# Installed as $TESTING_ROOT/env/api.env (mode 600, dir 700) and read by the
# testing-api and testing-worker containers (env_file in docker-compose.testing.yml).
# Modelled on infrastructure/deployment/vm/.env.vm.example (production VM kit).
#
# THE TESTING DATABASE IS A COPY OF REAL CUSTOMER DATA. Every value below is
# chosen so that nothing reaches a copied customer by default:
#   - every background scheduler / sender is switched OFF;
#   - the messaging recipient allowlist is ON with EMPTY lists (= nothing is sent);
#   - payments use Razorpay TEST keys only (a live key refuses to start);
#   - storage is a dedicated TESTING bucket, never a production bucket.
# See infrastructure/testing/docs/integrations.md before changing any of this.
#
# Legend: __GENERATE__  filled by install-testing.sh (random); never commit it
#         __SET_ME__    the operator must fill it in before install
#         empty         intentionally off / not configured
# No real values in this file. Never copy values from production env files.
# Apply a change: edit $TESTING_ROOT/env/api.env, then restart testing-api and
# testing-worker (both read this file).
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# docker-compose.testing.yml FORCES NODE_ENV=production, HOST=0.0.0.0, PORT=3000,
# REDIS_URL, TRUST_PROXY, REPORT_INSTANT_EXECUTION=false and STORAGE_LOCAL_DIR.
# Values set for these in api.env are IGNORED; the lines below are documentation. Production mode keeps Secure cookies,
# disables the development master OTP, hides error internals and refuses
# local-disk storage.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Marks this as the testing deployment. Enables the start-up safety checks
# (apps/api/src/services/deployment-safety.ts): a live Razorpay key refuses to
# start; a disabled recipient allowlist logs a loud WARN. Unset in production.
DEPLOYMENT_ENVIRONMENT=testing
# FORCED by compose to the testing_edge subnet (testing-proxy is the only client),
# so real client IPs reach rate limits and audit logs. Any value here is ignored.
# Never set TRUST_PROXY=true (it would trust X-Forwarded-For from anyone).
# TRUST_PROXY=
MAINTENANCE_MODE=false

# --- Database / Redis ---------------------------------------------------------
# [generated by install] postgresql://astro_testing:<pw>@testing-postgres:5432/astro_sushil_testing?schema=public
DATABASE_URL=__GENERATE__
# Leave unset; the API forces TimeZone=UTC on its own sessions.
# DATABASE_FORCE_UTC_SESSION=true
# FORCED by compose (value here ignored).
REDIS_URL=redis://testing-redis:6379/0

# --- Auth ---------------------------------------------------------------------
# [generated] >= 32 characters (openssl rand -hex 48). Must differ from production:
# production tokens must never be valid here. Changing it logs everyone out.
JWT_SECRET=__GENERATE__
# Signs private download links when set; falls back to JWT_SECRET. Generate a
# separate value so a leaked testing link secret is not the JWT secret.
STORAGE_SECRET=__GENERATE__
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=60d
# Never true in testing (also ignored when NODE_ENV=production). Testers log in
# with a real OTP sent to their own allowlisted phone / e-mail.
ALLOW_DEV_MASTER_OTP=false
# Must be true with NODE_ENV=production (the API refuses to start otherwise).
# Consequence: browser login works over HTTPS origins only.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# Leave unset (host-only cookies).
# AUTH_COOKIE_DOMAIN=
# Google sign-in was removed from the API (/auth/google answers "no longer
# available"); the variable is still parsed. Leave empty.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Public URLs / CORS ---------------------------------------------------------
# Public base URL of this API as the mobile app / download links see it
# (no trailing slash, no /api/v1). This is the API-only origin (no basic auth).
# Mode B / own hostnames (D = your domain): https://api-test.D
PUBLIC_API_URL=__SET_ME__
# Browser origins allowed to call the API with cookies, comma-separated, exact
# scheme://host[:port], no trailing slash. List BOTH the website and the admin
# origin for EVERY access mode in use:
#   Mode B / own hostnames:  https://test.D,https://admin-test.D
#   Cloudflare quick tunnel: ADD the two https://<random>.trycloudflare.com
#   origins (website + admin). They change on every tunnel restart: update this
#   and restart testing-api.
# Raw http://<IP>:18080 / :18081 origins cannot log in: auth cookies are
# Secure and are only set for listed origins. Use them for reachability only.
# NEVER list a production origin (astrosushil.com hosts).
CORS_ORIGIN=__SET_ME__
# Links inside messages (report-ready, booking, password reset) point here.
# Testing website / admin public URLs; NEVER the production domains.
# Mode B / own hostnames: FRONTEND_URL=https://test.D  ADMIN_URL=https://admin-test.D
FRONTEND_URL=__SET_ME__
ADMIN_URL=__SET_ME__

# --- File storage (dedicated TESTING bucket) --------------------------------------
# Production mode refuses local disk. Use a bucket created for testing only:
# AWS_STORAGE_BUCKET_NAME / AWS_S3_REGION_NAME must name the TESTING bucket,
# never a production bucket.
STORAGE_PROVIDER=aws
AWS_STORAGE_BUCKET_NAME=__SET_ME__
AWS_S3_REGION_NAME=__SET_ME__
AWS_ACCESS_KEY_ID=__SET_ME__
AWS_SECRET_ACCESS_KEY=__SET_ME__
# ACL sent with PUBLIC uploads: default public-read. Set "none" if the testing
# bucket has ACLs disabled and a bucket policy makes assets/* public.
# AWS_S3_PUBLIC_ACL=
# Comma-separated PRODUCTION bucket names. install / verify scripts refuse to run
# when the active bucket (AWS_STORAGE_BUCKET_NAME or R2_BUCKET_NAME) is in it.
# List at least: astrosushil,astro-sushil,pdfapilambda
TESTING_FORBIDDEN_BUCKETS=astrosushil,astro-sushil,pdfapilambda
# Alternative: Cloudflare R2 testing bucket (set STORAGE_PROVIDER=r2 instead):
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_REGION=auto

# --- Historical assets (Agent 4) ---
# See infrastructure/testing/docs/historical-assets.md.
# Comma- or space-separated bucket:region list. Stored URLs of these LEGACY
# buckets resolve to the same key in the ACTIVE (testing) bucket; the legacy
# bucket itself is never fetched. Set it only AFTER copy-historical-assets.sh
# has copied the objects into the testing bucket. Empty by default.
# Example testing value (the website's two buckets):
# STORAGE_LEGACY_AWS_BUCKETS=astrosushil:ap-south-1,astro-sushil:ap-southeast-2
STORAGE_LEGACY_AWS_BUCKETS=

# --- Report generation (worker; Google Gemini) ----------------------------------------
# REAL API, REAL COST. Use a key from a testing / capped Google project.
# Each fresh report makes roughly one Gemini call per narrative section
# (4-23 sections depending on the report, x up to 3 content attempts, plus
# transport retries); cached topics cost nothing. See docs/integrations.md.
# Without it every report fails with LLM_NOT_CONFIGURED.
GEMINI_API_KEY=__SET_ME__
# Defaults: reports gemini-3.1-flash-lite, final retry gemini-3.8-flash.
# GEMINI_MODEL=
# REPORT_LLM_MODEL=
# REPORT_LLM_RETRY_MODEL=
# REPORT_LLM_FALLBACK_MODELS=
# REPORT_LLM_PRICE_INPUT_PER_MTOK=      # only used for the estimated-cost log line
# REPORT_LLM_PRICE_OUTPUT_PER_MTOK=
# Forced to false by compose: the worker generates reports, the API does not.
REPORT_INSTANT_EXECUTION=false
# Must NOT be true: it would only matter for instant execution. Not a sender.
AUTO_DELIVER_WHEN_READY=false
# Automated PDF QA (poppler). Keep true.
REPORT_PDF_QA_ENABLED=true
# REPORT_ATTEMPT_TIMEOUT_MS=600000
# Worker waits this long for the running report on stop, then releases its claim.
# Keep below the compose stop_grace_period.
REPORT_SHUTDOWN_GRACE_MS=20000
# STALE_JOB_RECOVERY_INTERVAL_MS=60000
# WORKER_HEARTBEAT_INTERVAL_MS=20000

# --- Background schedulers: ALL OFF in testing ---------------------------------------
# Each is ON in code when unset (production unchanged). Enable ONE at a time,
# deliberately, after reading docs/integrations.md "Enabling a scheduler".
# Daily Rashi Bhavishya preparation: 24 Gemini calls per day (12 signs x EN/HI).
RASHI_BHAVISHYA_SCHEDULER_ENABLED=false
# Master switch of the messaging sweeps below (false = all of them off).
MESSAGING_SCHEDULER_ENABLED=false
# Individual messaging sweeps (apply only when MESSAGING_SCHEDULER_ENABLED is not false):
#   periodic outbox send/retry (copied PENDING rows would be sent!)
OUTBOX_DISPATCH_SCHEDULER_ENABLED=false
#   report-ready announcements after REPORT_SEND_DELAY_HOURS (push + e-mail + WhatsApp)
REPORT_RELEASE_SCHEDULER_ENABLED=false
#   daily reminder for tomorrow's consultations (e-mail + WhatsApp)
CONSULTATION_REMINDER_SCHEDULER_ENABLED=false
#   hourly delete of old OTP send-counter rows (database only, no sending)
OTP_CLEANUP_SCHEDULER_ENABLED=false
# API process sends right after queueing a message (OTP is always inline and is
# NOT affected). false = queued messages wait for the (disabled) worker sweep.
MESSAGING_INLINE_DISPATCH=false
# Pending-invoice numbering sweep (database only; ledger rows -> SUCCESS).
INVOICE_RECOVERY_ENABLED=false
# Report delivery-deadline monitor inside stale recovery: REPORT_DELAYED customer
# notification and re-queue of overdue copied reports (Gemini cost).
REPORT_SLA_SCHEDULER_ENABLED=false
# Recurring stale report-job recovery. Kept ON: it is part of on-demand report
# generation (expired leases are requeued). Start-up recovery always runs.
REPORT_STALE_RECOVERY_SCHEDULER_ENABLED=true
# Admin notification campaigns (announcements / promotions to many customers).
NOTIFICATION_CAMPAIGNS_ENABLED=false

# --- Messaging recipient allowlist (testing safety) ------------------------------------
# ON: SMS, WhatsApp, e-mail and push go ONLY to the recipients listed below;
# every other send is not made and is recorded as FAILED / RECIPIENT_NOT_ALLOWLISTED.
# Empty lists = nothing is sent at all. OTPs to listed testers ARE sent.
MESSAGING_RECIPIENT_ALLOWLIST_ENABLED=true
# Approved tester phones, comma-separated: 10-digit Indian, 91..., +91... or +<cc>...
MESSAGING_ALLOWED_PHONES=
# Approved tester e-mails, comma-separated, exact (case-insensitive); "@domain"
# allows every address at exactly that domain (e.g. a sandbox domain you own).
MESSAGING_ALLOWED_EMAILS=
# Push (FCM): user ids and/or device tokens of tester accounts, comma-separated.
PUSH_ALLOWED_USER_IDS=
PUSH_ALLOWED_DEVICE_TOKENS=

# --- Outbound messaging providers ---------------------------------------------------
# auto = real provider when its credentials are set, otherwise the send FAILS
# visibly (production mode). Credentials are empty by default, so nothing can be
# sent even before the allowlist. To test real delivery: fill the credentials AND
# add the tester's number / address to the allowlist above.
SMS_PROVIDER=auto
WHATSAPP_PROVIDER=auto
EMAIL_PROVIDER=auto
# SMSLane (DLT-registered texts live in the code). Only approved test numbers.
SMSLANE_API_KEY=
SMSLANE_CLIENT_ID=
SMSLANE_SENDER_ID=
# SMSLANE_API_URL=
# DLT-approved announcement text with {#var#} placeholders (campaign SMS).
# SMS_ANNOUNCEMENT_TEMPLATE=
# WhatChimp (approved templates). Only approved test numbers.
WHATCHIMP_API_TOKEN=
WHATCHIMP_PHONE_NUMBER_ID=
WHATCHIMP_TEMPLATE_ID=
WHATCHIMP_ORDER_TEMPLATE_ID=
WHATCHIMP_DIGITAL_ORDER_TEMPLATE_ID=
WHATCHIMP_REPORT_ORDER_CONFIRMED_TEMPLATE_ID=
WHATCHIMP_REPORT_TEMPLATE_ID=
WHATCHIMP_BOOKING_CONFIRMED_TEMPLATE_ID=
WHATCHIMP_BOOKING_UPDATED_TEMPLATE_ID=
WHATCHIMP_CONSULTATION_REMINDER_TEMPLATE_ID=
WHATCHIMP_CONSULTATION_RESCHEDULE_TEMPLATE_ID=
WHATCHIMP_ANNOUNCEMENT_TEMPLATE_ID=
# WHATCHIMP_API_URL=
# E-mail: an SMTP SANDBOX / test account (e.g. a capture-only test inbox), never
# the production mailbox. SMTP_* are the primary names; EMAIL_* are a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=
# Staff copies of order / booking / contact e-mails and WhatsApp go here: set to
# a TESTER address / number (and allowlist it), never the client's real inbox.
ADMIN_EMAIL=
ADMIN_PHONE=
# SUPPORT_PHONE=
# Behaviour (code defaults shown)
# REPORT_SEND_DELAY_HOURS=24
# CONSULTATION_REMINDER_IST_HOUR=8
# OTP_RATE_LIMIT_MAX=3
# OTP_RATE_LIMIT_WINDOW_MINUTES=10
# OTP_RATE_LIMIT_MAX_PER_DAY=10
# OTP_IP_RATE_LIMIT_MAX=10
# OTP_IP_RATE_LIMIT_WINDOW_MINUTES=10
# OTP_IP_RATE_LIMIT_MAX_PER_DAY=50
# MESSAGING_MAX_ATTEMPTS=4
# MESSAGING_RETRY_BASE_SECONDS=30
# MESSAGING_STALE_LOCK_MINUTES=10
# MESSAGING_DISPATCH_INTERVAL_MS=15000
# MESSAGING_DISPATCH_BATCH=50
# MESSAGING_HTTP_TIMEOUT_MS=10000

# --- Push notifications (Firebase, SEPARATE testing project) ---------------------------
# Use a Firebase project created for testing. Device tokens copied from
# production belong to the production project and are rejected by a different
# project; the push allowlist above is the second barrier.
# Either a mounted key file ...
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-testing.json
# ... or the three values:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Jyoti AI chat (OpenRouter) ---------------------------------------------------
# REAL API. Up to 3 HTTP attempts per chat message (primary + fallback models).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=__SET_ME__
# Must be a model OpenRouter lists today (https://openrouter.ai/models).
OPENROUTER_MODEL=__SET_ME__
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=Astro Sushil (testing)
# Per-user caps: keep them low in testing to bound cost.
JYOTI_RATE_LIMIT_PER_MINUTE=20
JYOTI_DAILY_LIMIT=200
# JYOTI_LLM_TOTAL_TIMEOUT_MS=

# --- Payments (Razorpay TEST keys only) ----------------------------------------------
# rzp_test_... keys only (RAZORPAY_KEY_ID starts with rzp_test_). A rzp_live_ key makes the API and worker refuse to start
# (DEPLOYMENT_ENVIRONMENT=testing). Production mode requires both values.
RAZORPAY_KEY_ID=__SET_ME__
RAZORPAY_KEY_SECRET=__SET_ME__
# Secret of a TEST-mode webhook pointing at THIS testing API's API-ONLY origin
# (https://api-test.D/api/v1/webhooks/razorpay). The website and admin origins
# are behind basic auth, so Razorpay cannot reach them. Never point a production
# webhook at testing, nor a testing webhook at production.
RAZORPAY_WEBHOOK_SECRET=__SET_ME__

# --- WhatsApp webhook (Meta) ---------------------------------------------------------
# Inbound only (logged, no reply). Production mode refuses verification without it.
# Leave empty unless a test Meta app is wired to this testing API; its callback
# must be the API-only origin: https://api-test.D/api/v1/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=

# --- Money: foreign currencies, invoices -----------------------------------------------
# exchangerate-api.com v6 key (REAL API, quota-limited; rates cached 24 h in
# Redis). Empty = only INR can be charged.
EXCHANGE_RATE_API_KEY=
# Seller details printed on invoices (fallback for the admin site settings).
# Test PDFs carry these values; use the client's real details only if invoices
# must look final, otherwise mark them as test.
INVOICE_SELLER_NAME=__SET_ME__
INVOICE_SELLER_TAGLINE=
INVOICE_SELLER_ADDRESS=__SET_ME__
INVOICE_SELLER_GSTIN=__SET_ME__
INVOICE_SELLER_STATE=__SET_ME__
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
INVOICE_SELLER_WEBSITE=
# Leave unset (numbering on).
# INVOICE_NUMBERING_ENABLED=
# INVOICE_RECOVERY_INTERVAL_MS=300000
# INVOICE_RECOVERY_BATCH=200
