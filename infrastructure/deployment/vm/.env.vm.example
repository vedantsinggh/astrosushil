# =============================================================================
# Astro Sushil API + worker environment for the small dev/showcase VM.
#
# setup.sh copies this file to /opt/astro-sushil/shared/api.env (mode 600) and
# fills the values marked "managed" or "__GENERATE__". deploy.sh links it to
# /opt/astro-sushil/app/apps/api/.env, which the API and worker both read
# (apps/api/src/config/index.ts loads .env from the working directory).
#
# Edit it on the VM:   nano /opt/astro-sushil/shared/api.env
# Apply changes:       pm2 restart astro-api astro-worker --update-env
#
# Legend: [REQUIRED] the process will not start without it
#         [managed]  rewritten by setup.sh on every run; change setup.sh flags instead
#         [generated] created once by setup.sh with openssl / urandom; never commit it
# Never copy values from your laptop's apps/api/.env into this file.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# The user chose development mode for this showcase VM. Consequences (README,
# "Development-mode risks"): master OTP login is active, mock payments are
# accepted, error responses include internal details, local-disk report
# storage and signed download links are enabled.
NODE_ENV=development
# [managed] 127.0.0.1 = reachable only through Caddy; 0.0.0.0 with --open-api-port.
HOST=127.0.0.1
# [managed] Caddy proxies to this port.
PORT=3000
# [managed] Trust X-Forwarded-For from Caddy on localhost so rate limits and
# audit logs see the real client IP (read in apps/api/src/app.ts).
TRUST_PROXY=127.0.0.1
# Set to true to return 503 for everything except health checks.
MAINTENANCE_MODE=false

# --- Database -----------------------------------------------------------------
# [REQUIRED][managed] Local PostgreSQL 16 created by setup.sh. The password is random.
DATABASE_URL=__GENERATE__
# The API forces TimeZone=UTC on its own DB sessions (adds options=-c TimeZone=UTC);
# setup.sh also sets the server's timezone to UTC. Leave this unset.
# DATABASE_FORCE_UTC_SESSION=true

# --- Auth ---------------------------------------------------------------------
# [REQUIRED][generated] >= 32 characters. setup.sh uses: openssl rand -hex 48
# Also signs local report download links. Changing it logs everyone out.
JWT_SECRET=__GENERATE__
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=60d

# Development master OTP. There is no SMS provider yet, so phone login only
# works with this code (see README "How testers log in").
# [generated] random 6-digit value; read it with:
#   sudo grep '^DEV_MASTER_OTP=' /opt/astro-sushil/shared/api.env
DEV_MASTER_OTP=__GENERATE__
ALLOW_DEV_MASTER_OTP=true

# Google Sign-In: comma-separated OAuth client IDs (Web client ID used as the
# app's GOOGLE_SERVER_CLIENT_ID, plus the iOS client ID). Empty = in development
# the API accepts any audience and logs a warning.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Public URLs / CORS ---------------------------------------------------------
# [managed] Public base URL of this API (no trailing slash, no /api/v1).
# Used to build signed report-PDF download links. setup.sh sets it to
# https://<--domain> or http://<public ip>.
PUBLIC_API_URL=__GENERATE__
# Browser origins allowed to call the API, comma-separated (admin panel).
# Note: with NODE_ENV=development the API accepts every origin anyway
# (apps/api/src/plugins/cors.ts); keep this list correct for later.
CORS_ORIGIN=http://localhost:3001

# --- Redis (optional) -----------------------------------------------------------
# [managed] Local Redis used for distributed locks. Empty = PostgreSQL advisory
# locks are used instead (setup.sh --no-redis).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Report PDF storage -----------------------------------------------------------
# [managed] Local disk storage (supported when NODE_ENV != production).
# Downloads go through PUBLIC_API_URL/api/v1/reports/download-secure?...
STORAGE_LOCAL_DIR=/var/lib/astro-sushil/storage
# Optional Cloudflare R2 / S3 instead of local disk (all three of account id,
# key id and secret must be set to switch):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=astro-sushil-reports
# R2_REGION=auto

# --- Report generation (worker) ----------------------------------------------------
# REQUIRED for reports: narrative topics are written by Google Gemini
# (apps/api/src/services/platform-report.runner.ts). Without it every report
# fails with LLM_NOT_CONFIGURED.
GEMINI_API_KEY=
# Model for reports and the daily Rashi Bhavishya (default in code: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# REPORT_LLM_MODEL=           # overrides GEMINI_MODEL for reports only
# REPORT_LLM_FALLBACK_MODELS= # comma-separated, tried when the primary is overloaded
# [managed by this kit] false = the API does not run reports itself; the single
# worker process generates them one at a time (needed on 1 GB RAM).
REPORT_INSTANT_EXECUTION=false
# Per-attempt wall-clock limit in ms. Can only SHORTEN the built-in 10 minutes.
# REPORT_ATTEMPT_TIMEOUT_MS=600000
# Automated PDF QA (poppler). true by default; set false only to debug a QA failure.
REPORT_PDF_QA_ENABLED=true
# Daily Rashi Bhavishya preparation in the worker: 12 Gemini calls per day.
# Set false to save LLM credit when nobody uses that screen.
RASHI_BHAVISHYA_SCHEDULER_ENABLED=true
# STALE_JOB_RECOVERY_INTERVAL_MS=60000
# WORKER_HEARTBEAT_INTERVAL_MS=20000
# On a restart / deploy (SIGTERM) the worker waits this long for the running
# report, then releases its claim so the new worker resumes it at once (finished
# LLM topics are cached). Keep it below kill_timeout in ecosystem.config.cjs (30 s).
REPORT_SHUTDOWN_GRACE_MS=20000

# --- Jyoti AI chat (OpenRouter) ---------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# MUST be a model that exists today. The defaults in apps/api/.env.example
# (minimax/minimax-m3:free) and in the config schema (poolside/laguna-s-2.1:free)
# are no longer listed by OpenRouter. Pick one from https://openrouter.ai/models
# (free ones end in ":free"), e.g. one you already use locally.
OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODELS=      # comma-separated
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_SITE_URL=https://astrosushil.com
# OPENROUTER_SITE_NAME=Astro Sushil
JYOTI_RATE_LIMIT_PER_MINUTE=20
JYOTI_DAILY_LIMIT=200
# JYOTI_LLM_TOTAL_TIMEOUT_MS=

# --- Payments (Razorpay TEST keys only) ----------------------------------------------
# Empty = in development the API creates mock orders and accepts mock_sig_*
# signatures (no real money). Use rzp_test_* keys to test the real checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- E-mail (optional) ------------------------------------------------------------
# Needed only for e-mail sign-up verification and password reset codes.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Astro Sushil <noreply@astrosushil.com>"

# --- WhatsApp webhook (optional) ----------------------------------------------------
# Without it, development mode accepts the well-known token 'astro_verify_token'.
# WHATSAPP_VERIFY_TOKEN=
