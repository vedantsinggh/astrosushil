FROM node:20.19.0-bookworm-slim AS builder

WORKDIR /app

# Copy root monorepo manifest and configs
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/api/ ./apps/api/

# Install dependencies and build workspace packages + Fastify API & Worker
RUN npm ci
RUN npm run db:generate --workspace=apps/api
RUN npm run build:packages
RUN npm run build:api

FROM node:20.19.0-bookworm-slim AS runner

WORKDIR /app

# Install XeLaTeX and LaTeX packages for PDF report compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-xetex \
    texlive-latex-extra \
    texlive-fonts-recommended \
    fonts-open-sans \
    fonts-texgyre \
    fonts-noto-core \
    poppler-utils \
    fontconfig \
    ghostscript \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app ./

CMD ["node", "apps/api/dist/worker.js"]
