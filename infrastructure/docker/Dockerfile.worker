FROM node:20-alpine AS builder

WORKDIR /app

# Copy root monorepo manifest and configs
COPY package.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Install dependencies and build workspace packages + Fastify API & Worker
RUN npm install
RUN npm run build:packages
RUN npm run build:api

FROM node:20-alpine AS runner

WORKDIR /app

# Install XeLaTeX and LaTeX packages for PDF report compilation
RUN apk add --no-cache \
    texlive-xetex \
    texlive-latex-extra \
    font-open-sans \
    font-tex-gyre \
    fontconfig \
    ghostscript

COPY --from=builder /app ./

CMD ["node", "apps/api/dist/worker.js"]
