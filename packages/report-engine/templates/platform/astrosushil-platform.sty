% ------------------------------------------------------------- headings --
\newcounter{asSection}
\newcommand{\AsSectionNum}{\ifnum\value{asSection}<10 0\fi\arabic{asSection}}

\newcommand{\ReportSection}[3]{% kicker, title, intro
  \clearpage\stepcounter{asSection}%
  \markboth{#2}{#2}%
  \phantomsection\addcontentsline{toc}{section}{#2}%
  \vspace*{2mm}%
  \begin{tcolorbox}[enhanced,colback=Tint,colframe=Accent!50,boxrule=0.55pt,arc=2mm,left=4.5mm,right=4mm,top=4mm,bottom=4mm,borderline north={2.2pt}{0pt}{Primary}]
    \noindent
    \begin{minipage}[c]{0.73\linewidth}
      {\colorbox{Primary}{\sffamily\fontsize{7}{8.5}\selectfont\bfseries\color{white}\ \AsSectionNum\ }}%
      \if\relax\detokenize{#1}\relax\else\enspace{\sffamily\fontsize{8}{9.5}\selectfont\bfseries\color{Accent}\MakeUppercase{#1}}\fi\par\vspace{2mm}%
      {\displayfont\fontsize{20}{25}\selectfont\color{Primary}#2\par}%
      \if\relax\detokenize{#3}\relax\else\vspace{1.8mm}{\fontsize{9.5}{13.2}\selectfont\itshape\color{Muted}#3\par}\fi
    \end{minipage}\hfill
    \begin{minipage}[c]{0.23\linewidth}\raggedleft
      \ifx\ReportSpotIllustration\as@empty\else
        \includegraphics[width=31mm,height=22mm,keepaspectratio]{\ReportSpotIllustration}%
      \fi
    \end{minipage}%
  \end{tcolorbox}%
  \SectionDivider
}

\newcommand{\ReportSectionJewel}[3]{% kicker, title, intro (alternating jewel banner)
  \clearpage\stepcounter{asSection}%
  \markboth{#2}{#2}%
  \phantomsection\addcontentsline{toc}{section}{#2}%
  \vspace*{2mm}%
  \begin{tcolorbox}[enhanced,colback=PrimaryDeep,colframe=Accent!75,boxrule=0.7pt,arc=2mm,left=4.5mm,right=4mm,top=4.2mm,bottom=4.2mm,borderline south={1.8pt}{0pt}{Accent}]
    \noindent
    \begin{minipage}[c]{0.73\linewidth}
      {\colorbox{Accent}{\sffamily\fontsize{7}{8.5}\selectfont\bfseries\color{PrimaryDeep}\ \AsSectionNum\ }}%
      \if\relax\detokenize{#1}\relax\else\enspace{\sffamily\fontsize{8}{9.5}\selectfont\bfseries\color{CoverBrightGold}\MakeUppercase{#1}}\fi\par\vspace{2mm}%
      {\displayfont\fontsize{20}{25}\selectfont\color{white}#2\par}%
      \if\relax\detokenize{#3}\relax\else\vspace{1.8mm}{\fontsize{9.5}{13.2}\selectfont\itshape\color{CoverGoldTint!88}#3\par}\fi
    \end{minipage}\hfill
    \begin{minipage}[c]{0.23\linewidth}\raggedleft
      \ifx\ReportSpotIllustration\as@empty\else
        \setlength{\fboxsep}{1mm}\fcolorbox{Accent!75}{white}{\includegraphics[width=28mm,height=20mm,keepaspectratio]{\ReportSpotIllustration}}%
      \fi
    \end{minipage}%
  \end{tcolorbox}%
  \SectionDivider
}

% Picture cropped to a rounded box: width, height, \includegraphics key that makes it cover the box, file
\newcommand{\AsImage}[4]{%
  \begin{tikzpicture}
    \clip[rounded corners=1.8mm] (0,0) rectangle (#1,#2);
    \node[inner sep=0pt] at ($(0,0)!0.5!(#1,#2)$) {\includegraphics[#3]{#4}};
    \draw[Accent!65,line width=0.6pt,rounded corners=1.8mm] (0,0) rectangle (#1,#2);
  \end{tikzpicture}%
}

\newcommand{\ReportTopic}[2]{% title, subtitle
  \needspace{9\baselineskip}%
  \vspace{4.5mm plus 2mm}%
  \phantomsection\addcontentsline{toc}{subsection}{#1}%
  {\displayfont\fontsize{14.5}{18}\selectfont\color{Primary}\textcolor{Accent}{\fontsize{9}{11}\selectfont$\diamondsuit$}\enspace #1\par}\vspace{0.8mm}%
  \if\relax\detokenize{#2}\relax\else{\fontsize{9.5}{12}\selectfont\itshape\color{Muted}#2\par}\vspace{0.6mm}\fi
  {\color{Accent!45}\rule{24mm}{0.8pt}}{\color{Rule}\rule{\dimexpr\linewidth-24mm\relax}{0.4pt}}\par\vspace{1.8mm}%
}
\newcommand{\TopicLead}[1]{{\fontsize{11}{15.5}\selectfont\color{Primary}#1\par}\vspace{1.5mm}}
