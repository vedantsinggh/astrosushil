% ---------------------------------------------------- North Indian chart --
% \NorthChart{scale}{h1}{h2}...{h12} — content for each house (sign number + planets)
\newcommand{\NorthChart}[1]{\def\nc@scale{#1}\NorthChartA}
\newcommand{\NorthChartA}[6]{\def\nc@a{#1}\def\nc@b{#2}\def\nc@c{#3}\def\nc@d{#4}\def\nc@e{#5}\def\nc@f{#6}\NorthChartB}
\newcommand{\NorthChartB}[6]{%
  \begin{tikzpicture}[scale=\nc@scale]
    \fill[Tint] (0,0) rectangle (8,8);
    \draw[Primary,line width=1.2pt] (0,0) rectangle (8,8);
    \draw[Accent,line width=0.8pt] (0,4) -- (4,8) -- (8,4) -- (4,0) -- cycle;
    \draw[Primary!40,line width=0.6pt] (0,0) -- (8,8);
    \draw[Primary!40,line width=0.6pt] (0,8) -- (8,0);
    \tikzset{hc/.style={align=center,text=Ink,font=\sffamily\fontsize{7}{8.4}\selectfont}}
    \node[hc] at (4,6.0) {\nc@a};
    \node[hc] at (2,7.1) {\nc@b};
    \node[hc] at (0.95,6.0) {\nc@c};
    \node[hc] at (2.0,4.0) {\nc@d};
    \node[hc] at (0.95,2.0) {\nc@e};
    \node[hc] at (2.0,0.9) {\nc@f};
    \node[hc] at (4.0,2.0) {#1};
    \node[hc] at (6.0,0.9) {#2};
    \node[hc] at (7.05,2.0) {#3};
    \node[hc] at (6.0,4.0) {#4};
    \node[hc] at (7.05,6.0) {#5};
    \node[hc] at (6.0,7.1) {#6};
  \end{tikzpicture}%
}
\newcommand{\SignNo}[1]{{\fontsize{6}{7}\selectfont\color{Accent}\bfseries #1}}

