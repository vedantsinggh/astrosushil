% ---------------------------------------------------------- stat strips --
\newcommand{\asStatCell}[2]{% label, value
  {\sffamily\fontsize{6.8}{8.5}\selectfont\bfseries\color{Muted}\MakeUppercase{#1}}\par\vspace{0.8mm}%
  {\sffamily\fontsize{9.5}{12}\selectfont\bfseries\color{Primary}#2}%
}
\newcommand{\asStatStripThree}[6]{%
  \needspace{4\baselineskip}%
  \begin{tcolorbox}[enhanced,colback=PrimarySoft,colframe=Accent!45,boxrule=0.5pt,arc=1.5mm,left=3mm,right=3mm,top=2.5mm,bottom=2.5mm]
    \begin{tabularx}{\linewidth}{@{}X|X|X@{}}
      \asStatCell{#1}{#2} & \asStatCell{#3}{#4} & \asStatCell{#5}{#6}
    \end{tabularx}
  \end{tcolorbox}\vspace{1.5mm}%
}
\newcommand{\asStatStripFour}[8]{%
  \needspace{4\baselineskip}%
  \begin{tcolorbox}[enhanced,colback=PrimarySoft,colframe=Accent!45,boxrule=0.5pt,arc=1.5mm,left=3mm,right=3mm,top=2.5mm,bottom=2.5mm]
    \begin{tabularx}{\linewidth}{@{}X|X|X|X@{}}
      \asStatCell{#1}{#2} & \asStatCell{#3}{#4} & \asStatCell{#5}{#6} & \asStatCell{#7}{#8}
    \end{tabularx}
  \end{tcolorbox}\vspace{1.5mm}%
}

% ------------------------------------------------------------ timelines --
\newcommand{\asTimelineItem}[3]{% date, title, detail
  \needspace{3.5\baselineskip}%
  \noindent\begin{minipage}[t]{7.5mm}\vspace{0.5pt}\centering\TimelinePin\end{minipage}\hfill
  \begin{minipage}[t]{\dimexpr\linewidth-9.5mm\relax}\vspace{0pt}%
    {\colorbox{Tint}{\sffamily\fontsize{7.5}{9.5}\selectfont\bfseries\color{Primary}\ #1\ }}\enspace{\fontsize{9.5}{12.5}\selectfont\textbf{\color{Ink}#2}}%
    \if\relax\detokenize{#3}\relax\else\par\vspace{0.5mm}{\fontsize{8.7}{12}\selectfont\color{Muted}#3}\fi
    \par\vspace{1.8mm}%
  \end{minipage}\par
}
\newcommand{\asTimelineItemActive}[3]{% date, title, detail
  \needspace{4\baselineskip}%
  \begin{tcolorbox}[enhanced,colback=Tint!75!white,colframe=Accent!60,boxrule=0.5pt,arc=1.4mm,left=2.5mm,right=3mm,top=2mm,bottom=2mm,borderline west={2.5pt}{0pt}{Primary}]
    \noindent\begin{minipage}[t]{7mm}\vspace{0.5pt}\centering\TimelinePin\end{minipage}\hfill
    \begin{minipage}[t]{\dimexpr\linewidth-9mm\relax}\vspace{0pt}%
      {\colorbox{Primary}{\sffamily\fontsize{7.5}{9.5}\selectfont\bfseries\color{white}\ #1\ }}\enspace{\fontsize{9.5}{12.5}\selectfont\textbf{\color{Primary}#2}}%
      \if\relax\detokenize{#3}\relax\else\par\vspace{0.5mm}{\fontsize{8.7}{12}\selectfont\color{Ink}#3}\fi
      \par
    \end{minipage}%
  \end{tcolorbox}\vspace{0.6mm}%
}

