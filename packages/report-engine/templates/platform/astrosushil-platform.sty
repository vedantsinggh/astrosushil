% ---------------------------------------------------------------- chrome --
\newcommand{\ReportRunningTitle}{}
\newcommand{\PreparedForLine}{Prepared for \ClientName}
\fancypagestyle{asreport}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyhead[L]{\sffamily\fontsize{7}{8.5}\selectfont\color{Muted}ASTRO SUSHIL\enspace\textcolor{Rule}{|}\enspace\MakeUppercase{\leftmark}}%
  \fancyhead[R]{\sffamily\fontsize{7}{8.5}\selectfont\color{Primary}\bfseries\ReportRunningTitle}%
  \fancyhead[C]{\begin{tikzpicture}[remember picture,overlay]
      \draw[Rule,line width=0.5pt]([xshift=12mm,yshift=-12mm]current page.north west) rectangle ([xshift=-12mm,yshift=12mm]current page.south east);
      \draw[Accent!50,line width=0.35pt]([xshift=13.5mm,yshift=-13.5mm]current page.north west) rectangle ([xshift=-13.5mm,yshift=13.5mm]current page.south east);
      \draw[Rule,line width=0.4pt]([xshift=20mm,yshift=-17mm]current page.north west) -- ([xshift=-20mm,yshift=-17mm]current page.north east);
      \draw[Rule,line width=0.4pt]([xshift=20mm,yshift=17mm]current page.south west) -- ([xshift=-20mm,yshift=17mm]current page.south east);
    \end{tikzpicture}}%
  \fancyfoot[L]{\sffamily\fontsize{7}{8.5}\selectfont\color{Muted}\PreparedForLine\enspace\textcolor{Rule}{|}\enspace astrosushil.com}%
  \fancyfoot[R]{\sffamily\fontsize{7.5}{9}\selectfont\bfseries\color{Primary}\thepage\ / \pageref*{LastPage}}%
}
\pagestyle{asreport}

% ------------------------------------------------------------- headings --
\newcounter{asSection}
\newcommand{\ReportSection}[3]{% kicker, title, intro
  \clearpage\stepcounter{asSection}%
  \markboth{#2}{#2}%
  \phantomsection\addcontentsline{toc}{section}{#2}%
  \vspace*{6mm}%
  {\sffamily\fontsize{8.5}{10}\selectfont\bfseries\color{Accent}\MakeUppercase{#1}}\par\vspace{2mm}%
  {\displayfont\fontsize{22}{27}\selectfont\color{Primary}#2\par}\vspace{1.5mm}%
  {\color{Accent}\rule{38mm}{0.9pt}}\par\vspace{2.5mm}%
  \ifx\relax#3\relax\else{\fontsize{10}{14}\selectfont\itshape\color{Muted}#3\par}\vspace{3mm}\fi
}
\newcommand{\ReportTopic}[2]{% title, subtitle
  \needspace{9\baselineskip}%
  \vspace{4mm plus 2mm}%
  \phantomsection\addcontentsline{toc}{subsection}{#1}%
  {\displayfont\fontsize{14.5}{18}\selectfont\color{Primary}#1\par}\vspace{0.8mm}%
  \ifx\relax#2\relax\else{\fontsize{9.5}{12}\selectfont\itshape\color{Muted}#2\par}\vspace{0.6mm}\fi
  {\color{Rule}\rule{\linewidth}{0.4pt}}\par\vspace{1.8mm}%
}
\newcommand{\TopicLead}[1]{{\fontsize{11}{15.5}\selectfont\color{Primary}#1\par}\vspace{1.5mm}}
\newenvironment{gemlist}{\begin{itemize}[leftmargin=6mm,itemsep=2.5pt,parsep=0pt,topsep=3pt,label={\textcolor{Accent}{\small$\diamondsuit$}}]}{\end{itemize}}

% --------------------------------------------------------------- boxes --
\newtcolorbox{asCard}[1][]{enhanced,colback=white,colframe=Rule,boxrule=0.6pt,arc=1.5mm,left=4mm,right=4mm,top=3mm,bottom=3mm,borderline west={2.5pt}{0pt}{Accent},#1}
\newtcolorbox{asHighlight}[1][]{enhanced,colback=Tint,colframe=Accent!45,boxrule=0.6pt,arc=1.5mm,left=4mm,right=4mm,top=3mm,bottom=3mm,borderline west={2.5pt}{0pt}{Accent},#1}
\newtcolorbox{asCaution}[1][]{enhanced,colback=CautionTint,colframe=Caution!30,boxrule=0.6pt,arc=1.5mm,left=4mm,right=4mm,top=3mm,bottom=3mm,borderline west={2.5pt}{0pt}{Caution},#1}
\newcommand{\CardTitle}[1]{{\sffamily\fontsize{8.5}{10.5}\selectfont\bfseries\color{Primary}\MakeUppercase{#1}}\par\vspace{1.2mm}}
\newcommand{\Takeaway}[1]{\begin{asHighlight}\CardTitle{In Essence}{\fontsize{9.8}{13.5}\selectfont #1\par}\end{asHighlight}}
\newcommand{\SourceNote}[1]{{\sffamily\fontsize{6.8}{8.5}\selectfont\color{Muted}#1\par}}

