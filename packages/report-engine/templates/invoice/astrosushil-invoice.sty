% =========================================================================
% Astro Sushil GST invoice: document style (XeLaTeX).
% Independent of the report platform style: it shares only the fonts the
% server already has (TeX Gyre Pagella, Open Sans, Noto Serif Devanagari).
% Loaded by packages/report-engine/src/invoice/render.ts. No dynamic text
% lives here; every value arrives through the macros below, already escaped.
% =========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{astrosushil-invoice}[2026/11/24 v1.0 Astro Sushil invoice]

\RequirePackage[a4paper,top=14mm,bottom=24mm,left=15mm,right=15mm,footskip=12mm]{geometry}
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{TeX Gyre Pagella}
\setsansfont{Open Sans}
\IfFontExistsTF{Noto Serif Devanagari}{%
  \newfontfamily\devanagarifont{Noto Serif Devanagari}[Script=Devanagari]%
  % The rupee sign is in neither Latin font; the Devanagari font carries it.
  \newcommand{\Rs}{{\devanagarifont\symbol{"20B9}}}%
}{%
  \newfontfamily\devanagarifont{FreeSerif}[Script=Devanagari]%
  \newcommand{\Rs}{Rs.\,}%
}
\RequirePackage{ucharclasses}
\setTransitionsForDevanagari{\bgroup\devanagarifont}{\egroup}
\RequirePackage{newunicodechar}
\newunicodechar{₹}{\Rs}

\RequirePackage{xcolor}
\definecolor{InvInk}{HTML}{1A1A2E}
\definecolor{InvText}{HTML}{374151}
\definecolor{InvMuted}{HTML}{6B7280}
\definecolor{InvGold}{HTML}{A8916A}
\definecolor{InvBrightGold}{HTML}{C4A96A}
\definecolor{InvRule}{HTML}{E8E2D5}
\definecolor{InvSurface}{HTML}{FAFAF8}
\definecolor{InvGreen}{HTML}{1A6B2F}
\definecolor{InvAmber}{HTML}{92400E}
\definecolor{InvRed}{HTML}{991B1B}

\RequirePackage[most]{tcolorbox}
\RequirePackage{array,colortbl,longtable}
\RequirePackage{ragged2e}
\RequirePackage{fancyhdr}

% Page total for "Page 1 of 2", without the lastpage and hyperref packages (they double the load
% time). The renderer seeds the .aux file with a total of 1, which is right for almost every
% invoice, so one pass is enough; when the real total differs LaTeX reports changed labels and the
% renderer runs a second pass.
\AtEndDocument{\clearpage\addtocounter{page}{-1}%
  \immediate\write\@auxout{\string\newlabel{LastPage}{{}{\thepage}}}\addtocounter{page}{1}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\renewcommand{\arraystretch}{1.3}
% Names, e-mail addresses and identifiers are never hyphenated.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\color{InvText}

% ---------------------------------------------------------------- footer --
% \InvFooterSignatory and \InvFooterNumber are set by the renderer.
\newcommand{\InvFooterSignatory}{}
\newcommand{\InvFooterNumber}{}
\fancypagestyle{asinvoice}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[C]{\parbox{\textwidth}{\centering\sffamily\fontsize{7.2}{10}\selectfont\color{InvGold}%
    {\color{InvRule}\rule{\textwidth}{0.4pt}}\\[1.2mm]
    \leavevmode\InvFooterSignatory\\
    Thank you for your trust and belief.\\
    This is a system-generated invoice and does not require a physical signature.\\
    {\color{InvMuted}\InvFooterNumber\enspace|\enspace Page \thepage\ of \pageref{LastPage}}}}%
}
\pagestyle{asinvoice}

% ---------------------------------------------------------------- header --
% \InvHeader{seller name}{tagline}{seller lines}{invoice number}{date lines}
\newcommand{\InvHeader}[5]{%
  \begin{tcolorbox}[enhanced,colback=InvInk,colframe=InvInk,arc=1.2mm,boxrule=0pt,
      left=6mm,right=6mm,top=5mm,bottom=5mm,borderline south={1.2pt}{0pt}{InvBrightGold}]
    \begin{minipage}[t]{0.62\linewidth}\RaggedRight
      {\fontsize{15}{18}\selectfont\bfseries\color{white}#1\par}
      \ifx\relax#2\relax\else\vspace{0.8mm}{\sffamily\fontsize{7.5}{10}\selectfont\color{InvBrightGold}#2\par}\fi
      \vspace{2.4mm}{\sffamily\fontsize{7.6}{11}\selectfont\color{white!72!InvInk}#3\par}
    \end{minipage}\hfill
    \begin{minipage}[t]{0.34\linewidth}\RaggedLeft
      {\fontsize{24}{26}\selectfont\bfseries\color{InvBrightGold}INVOICE\par}
      \vspace{1.6mm}{\sffamily\fontsize{9.5}{12}\selectfont\bfseries\color{white}#4\par}
      \vspace{1.8mm}{\sffamily\fontsize{7.6}{11}\selectfont\color{white!72!InvInk}#5\par}
    \end{minipage}
  \end{tcolorbox}%
}

% ----------------------------------------------------------------- strip --
\newcommand{\InvLabel}[1]{\leavevmode{\sffamily\fontsize{6.4}{8}\selectfont\bfseries\color{InvGold}\MakeUppercase{#1}}}
% \InvFact{label}{value}: one cell of the facts strip under the header
\newcommand{\InvFact}[2]{\begin{minipage}[t]{\linewidth}\RaggedRight\InvLabel{#1}\par\vspace{0.4mm}%
  {\sffamily\fontsize{8.4}{10.5}\selectfont\bfseries\color{InvInk}#2\par}\end{minipage}}
\newcommand{\InvPaid}[1]{\leavevmode{\color{InvGreen}#1}}
\newcommand{\InvPending}[1]{\leavevmode{\color{InvAmber}#1}}
\newcommand{\InvFailed}[1]{\leavevmode{\color{InvRed}#1}}

% ----------------------------------------------------------------- cards --
% The customer, shipping and payment blocks are columns of one box, so they always line up.
\newenvironment{InvCards}{\begin{tcolorbox}[enhanced,colback=InvSurface,colframe=InvRule,boxrule=0.5pt,arc=1.2mm,
  left=4mm,right=4mm,top=3mm,bottom=3mm,before skip=3mm,after skip=4mm]}{\end{tcolorbox}}
% \begin{InvCard}{heading}{width}
\newenvironment{InvCard}[2]{\begin{minipage}[t]{#2}\InvLabel{#1}\par\vspace{1.4mm}%
  \sffamily\fontsize{8.4}{12}\selectfont\RaggedRight}{\par\end{minipage}}
\newcommand{\InvStrong}[1]{\leavevmode{\bfseries\color{InvInk}#1}}
\newcommand{\InvMutedText}[1]{{\color{InvMuted}#1}}
% \InvPair{label}{value}: label left, value right, inside a card
\newcommand{\InvPair}[2]{\leavevmode\makebox[\linewidth]{\InvMutedText{#1}\hfill\parbox[t]{0.68\linewidth}{\RaggedLeft\leavevmode #2}}\par}

% ----------------------------------------------------------------- items --
% A colour change in front of a cell's first character would otherwise sit on a line of its own
% and push the cell down, so every cell macro starts its paragraph first (\leavevmode).
\newcommand{\InvTh}[1]{\leavevmode{\sffamily\fontsize{6.6}{8.5}\selectfont\bfseries\color{InvBrightGold}\MakeUppercase{#1}}}
\newcommand{\InvTd}[1]{\leavevmode{\sffamily\fontsize{8.2}{11}\selectfont #1}}
\newcommand{\InvItemTitle}[1]{\leavevmode{\sffamily\fontsize{8.6}{11.5}\selectfont\bfseries\color{InvInk}#1}}
\newcommand{\InvItemNote}[1]{\par{\sffamily\fontsize{7.2}{9.5}\selectfont\color{InvMuted}#1}}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\RaggedLeft\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\Centering\arraybackslash}p{#1}}

% ---------------------------------------------------------------- totals --
\newcommand{\InvTotalRow}[2]{\leavevmode{\sffamily\fontsize{8.4}{11}\selectfont\color{InvMuted}#1} & \leavevmode{\sffamily\fontsize{8.4}{11}\selectfont #2}\\}
\newcommand{\InvDiscountRow}[2]{\leavevmode{\sffamily\fontsize{8.4}{11}\selectfont\color{InvGreen}#1} & \leavevmode{\sffamily\fontsize{8.4}{11}\selectfont\color{InvGreen}#2}\\}
% \InvGrand{label}{amount}{lines beneath, may be empty}
\newcommand{\InvGrand}[3]{%
  \begin{tcolorbox}[enhanced,colback=InvInk,colframe=InvInk,arc=1.2mm,boxrule=0pt,left=4mm,right=4mm,top=2.6mm,bottom=2.6mm]
    {\fontsize{11}{14}\selectfont\color{white}#1}\hfill{\fontsize{14}{16}\selectfont\bfseries\color{InvBrightGold}#2}%
    \ifx\relax#3\relax\else\par\vspace{1.2mm}{\sffamily\fontsize{7.2}{10}\selectfont\color{white!72!InvInk}\RaggedLeft #3\par}\fi
  \end{tcolorbox}%
}
\newcommand{\InvNote}[1]{{\sffamily\fontsize{7.2}{10}\selectfont\color{InvMuted}#1\par}}
\endinput
